<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Artefakttyper för account_ai (okf-mixin D12).

        Kärnans okf_default_artifact_types.xml får inga nya rader — kärnan
        ska förbli domän-ren. Bryggan registrerar sina egna typer, med
        bridge_module satt så taxonomin går att spåra tillbaka hit.

        stale_policy 'source': verifikatets text ändras i källan (rader
        redigeras, part byts) — konceptet blir inaktuellt när källan ändras,
        inte efter en fast TTL.

        retention_purpose:
          account_move    'none'      — redovisningsdata speglas, gallras inte.
                                        retention_days=0 undviker motsägelsen
                                        'none' + dagar > 0 som
                                        _check_okf_contract avvisar.
          account_account 'accounting' — kontoplanen är redovisningsunderlag.
                                        Även här 0 dagar: ett konto gäller
                                        tills det ändras, inte i N dagar.
    -->
    <data noupdate="1">
        <record id="artifact_type_account_move" model="ai.artifact.type">
            <field name="name">account_move</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">account_ai</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'none', 'retention_days': 0}"/>
        </record>
        <record id="artifact_type_account_account" model="ai.artifact.type">
            <field name="name">account_account</field>
            <field name="kind">knowledge</field>
            <field name="bridge_module">account_ai</field>
            <field name="model_id" ref="account.model_account_account"/>
            <field name="okf_contract" eval="{'generated_by': 'process', 'stale_policy': 'source', 'stale_ttl_days': 0, 'retention_purpose': 'accounting', 'retention_days': 0}"/>
        </record>
    </data>
</odoo>
