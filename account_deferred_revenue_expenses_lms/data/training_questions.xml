<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="question_periodization" model="account.deferred.lms.question">
            <field name="lesson_id" ref="account_deferred_revenue_expenses_lms.lesson_basics_what"/>
            <field name="sequence">10</field>
            <field name="name">Vad innebär periodiseringsprincipen?</field>
            <field name="answer_a">Att alla transaktioner bokförs när betalning sker</field>
            <field name="answer_b">Att intäkter och kostnader redovisas i den period de hör hemma</field>
            <field name="answer_c">Att alla konton ska ha samma saldo vid årets slut</field>
            <field name="answer_d">Att man alltid använder kontantmetoden</field>
            <field name="correct_answer">b</field>
            <field name="explanation">
&lt;p&gt;Periodiseringsprincipen innebär att intäkter och kostnader ska redovisas i den
period de avser, oavsett när betalningen sker. Detta följer av ÅRL 2 kap 4§.&lt;/p&gt;
            </field>
        </record>

        <record id="question_bas_account_expense" model="account.deferred.lms.question">
            <field name="lesson_id" ref="account_deferred_revenue_expenses_lms.lesson_expense"/>
            <field name="sequence">10</field>
            <field name="name">Vilket BAS-konto används normalt för förutbetalda kostnader?</field>
            <field name="answer_a">1710 Förutbetalda kostnader</field>
            <field name="answer_b">1930 Företagskonto</field>
            <field name="answer_c">2440 Leverantörsskuld</field>
            <field name="answer_d">2990 Förutbetalda intäkter</field>
            <field name="correct_answer">a</field>
            <field name="explanation">
&lt;p&gt;BAS 1710 används för förutbetalda kostnader och upplupna intäkter.
2990 är för förutbetalda intäkter (kreditsidan).&lt;/p&gt;
            </field>
        </record>

        <record id="question_bas_account_income" model="account.deferred.lms.question">
            <field name="lesson_id" ref="account_deferred_revenue_expenses_lms.lesson_income"/>
            <field name="sequence">10</field>
            <field name="name">När du periodiserar en förutbetald intäkt månadsvis, vilket konto krediteras?</field>
            <field name="answer_a">2990 Förutbetalda intäkter</field>
            <field name="answer_b">1710 Förutbetalda kostnader</field>
            <field name="answer_c">3010 Försäljning</field>
            <field name="answer_d">1930 Företagskonto</field>
            <field name="correct_answer">c</field>
            <field name="explanation">
&lt;p&gt;Vid periodisering av förutbetald intäkt debiteras 2990 och intäktskontot
(t.ex. 3010) krediteras. På så sätt flyttas intäkten successivt från balans-
till resultaträkningen.&lt;/p&gt;
            </field>
        </record>

    </data>
</odoo>
