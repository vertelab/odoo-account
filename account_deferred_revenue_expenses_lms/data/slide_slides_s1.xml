        <field name="description">Mindmap: Hierarkin för svensk redovisning — från lagar (BFL, ÅRL) via normgivning (BFNAR, RFR) till praxis (BAS-kontoplanen).</field>
    </record>

    <!-- SLIDE 1.4: Quiz — Grunderna -->
    <record id="slide_s1_04" model="slide.slide">
        <field name="name">🧪 Testa dina kunskaper — Grunderna</field>
        <field name="sequence">40</field>
        <field name="slide_category">quiz</field>
        <field name="channel_id" ref="account_deferred_revenue_expenses_lms.slide_channel_deferred"/>
        <field name="is_published" eval="True"/>
        <field name="is_preview" eval="False"/>
        <field name="completion_time">0.25</field>
        <field name="quiz_first_attempt_reward">100</field>
        <field name="quiz_second_attempt_reward">75</field>
        <field name="quiz_third_attempt_reward">50</field>
        <field name="quiz_fourth_attempt_reward">25</field>
        <field name="description">Testa dina kunskaper om periodiseringsprincipen, lagkrav och regelverk.</field>
    </record>

    <!-- QUIZ QUESTIONS -->

    <record id="slide_s1_04_q1" model="slide.question">
        <field name="question">Vad innebär periodiseringsprincipen?</field>
        <field name="sequence">1</field>
        <field name="slide_id" ref="slide_s1_04"/>
    </record>
    <record id="slide_s1_04_q1_a1" model="slide.answer">
        <field name="text_value">Alla transaktioner bokförs när betalning sker</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Detta är kontantmetoden — inte periodiseringsprincipen.</field>
        <field name="question_id" ref="slide_s1_04_q1"/>
    </record>
    <record id="slide_s1_04_q1_a2" model="slide.answer">
        <field name="text_value">Intäkter och kostnader redovisas i den period de hör hemma</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Periodiseringsprincipen enligt ÅRL 2 kap 4§ — oavsett betaltidpunkt.</field>
        <field name="question_id" ref="slide_s1_04_q1"/>
    </record>
    <record id="slide_s1_04_q1_a3" model="slide.answer">
        <field name="text_value">Alla konton ska ha samma saldo vid årets slut</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Det finns inget krav på att alla konton ska ha samma saldo.</field>
        <field name="question_id" ref="slide_s1_04_q1"/>
    </record>

    <record id="slide_s1_04_q2" model="slide.question">
        <field name="question">Vilket regelverk är huvudregelverket för svensk redovisning?</field>
        <field name="sequence">2</field>
        <field name="slide_id" ref="slide_s1_04"/>
    </record>
    <record id="slide_s1_04_q2_a1" model="slide.answer">
        <field name="text_value">K1 (BFNAR 2006:1) — Förenklat årsbokslut</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! K1 är för enskilda firmor och ideella föreningar med förenklat årsbokslut.</field>
        <field name="question_id" ref="slide_s1_04_q2"/>
    </record>
    <record id="slide_s1_04_q2_a2" model="slide.answer">
        <field name="text_value">K2 (BFNAR 2016:10) — För mindre aktiebolag</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! K2 är ett frivilligt förenklingsregelverk för mindre företag.</field>
        <field name="question_id" ref="slide_s1_04_q2"/>
    </record>
    <record id="slide_s1_04_q2_a3" model="slide.answer">
        <field name="text_value">K3 (BFNAR 2012:1) — Huvudregelverket</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! K3 är huvudregelverket för svensk redovisning. K2 är ett frivilligt alternativ.</field>
        <field name="question_id" ref="slide_s1_04_q2"/>
    </record>

    <record id="slide_s1_04_q3" model="slide.question">
        <field name="question">En förutbetald kostnad på 120 000 kr för ett år periodiseras månadsvis. Hur mycket kostnadsförs per månad?</field>
        <field name="sequence">3</field>
        <field name="slide_id" ref="slide_s1_04"/>
    </record>
    <record id="slide_s1_04_q3_a1" model="slide.answer">
        <field name="text_value">120 000 kr</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Då skulle hela kostnaden tas på en månad — precis vad periodisering ska undvika.</field>
        <field name="question_id" ref="slide_s1_04_q3"/>
    </record>
    <record id="slide_s1_04_q3_a2" model="slide.answer">
        <field name="text_value">10 000 kr</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! 120 000 kr ÷ 12 månader = 10 000 kr per månad.</field>
        <field name="question_id" ref="slide_s1_04_q3"/>
    </record>
    <record id="slide_s1_04_q3_a3" model="slide.answer">
        <field name="text_value">5 000 kr</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! 120 000 / 12 = 10 000, inte 5 000.</field>
        <field name="question_id" ref="slide_s1_04_q3"/>
    </record>

    <record id="slide_s1_04_q4" model="slide.question">
        <field name="question">Vad innebär principen om bokföringsmässiga grunder (accrual basis)?</field>
        <field name="sequence">4</field>
        <field name="slide_id" ref="slide_s1_04"/>
    </record>
    <record id="slide_s1_04_q4_a1" model="slide.answer">
        <field name="text_value">Att alla transaktioner bokförs samma dag som de betalas</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Det är kontantprincipen — motsatsen till accrual basis.</field>
        <field name="question_id" ref="slide_s1_04_q4"/>
    </record>
    <record id="slide_s1_04_q4_a2" model="slide.answer">
        <field name="text_value">Att intäkter och kostnader redovisas när de uppstår, oavsett betalningstidpunkt</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! Accrual basis (bokföringsmässiga grunder) innebär att transaktionen redovisas när den ekonomiska händelsen inträffar.</field>
        <field name="question_id" ref="slide_s1_04_q4"/>
    </record>
    <record id="slide_s1_04_q4_a3" model="slide.answer">
        <field name="text_value">Att alla konton måste balansera vid månadsskifte</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! Att konton balanserar är dubbel bokföring — inte accrual basis.</field>
        <field name="question_id" ref="slide_s1_04_q4"/>
    </record>

    <record id="slide_s1_04_q5" model="slide.question">
        <field name="question">Vilket av följande är INTE ett giltigt alternativ enligt BFNAR?</field>
        <field name="sequence">5</field>
        <field name="slide_id" ref="slide_s1_04"/>
    </record>
    <record id="slide_s1_04_q5_a1" model="slide.answer">
        <field name="text_value">K1 — Förenklat årsbokslut (BFNAR 2006:1)</field>
        <field name="sequence">1</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! K1 är ett giltigt regelverk för enskilda firmor och ideella föreningar.</field>
        <field name="question_id" ref="slide_s1_04_q5"/>
    </record>
    <record id="slide_s1_04_q5_a2" model="slide.answer">
        <field name="text_value">K2 — Förenklingsregelverk för mindre aktiebolag (BFNAR 2016:10)</field>
        <field name="sequence">2</field>
        <field name="is_correct" eval="False"/>
        <field name="comment">Incorrect! K2 är ett giltigt och vanligt alternativ för mindre AB.</field>
        <field name="question_id" ref="slide_s1_04_q5"/>
    </record>
    <record id="slide_s1_04_q5_a3" model="slide.answer">
        <field name="text_value">K4 — Internationell redovisningsstandard (BFNAR 2020:5)</field>
        <field name="sequence">3</field>
        <field name="is_correct" eval="True"/>
        <field name="comment">Correct! K4 existerar inte. De giltiga nivåerna är K1, K2, K3 och IFRS (via RFR).</field>
        <field name="question_id" ref="slide_s1_04_q5"/>
    </record>

