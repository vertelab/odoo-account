    <!-- SLIDE 1.1: Vad är periodisering? -->
    <record id="slide_s1_01" model="slide.slide">
        <field name="name">Vad är periodisering?</field>
        <field name="sequence">10</field>
        <field name="slide_category">article</field>
        <field name="channel_id" ref="account_deferred_revenue_expenses_lms.slide_channel_deferred"/>
