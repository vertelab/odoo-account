<odoo>

    <record id="view_vendor_bill_approval_user_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.user.form</field>
        <field name="model">vendor.bill.approval.user</field>
        <field name="arch" type="xml">
            <form string="Send Vendor Bill Approval Request">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="line_ids" widget="many2many_checkboxes"/>
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Send Request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_vendor_bill_approval_reject_form" model="ir.ui.view">
        <field name="name">vendor.bill.approval.reject.form</field>
        <field name="model">vendor.bill.approval.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Vendor Bill">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="line_id" readonly="1"/>
                </group>
                <group>
                    <field name="reason" placeholder="Why is this bill rejected?"
                           required="1"/>
                </group>
                <footer>
                    <button name="action_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
