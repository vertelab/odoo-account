<odoo>

    <record id="view_partner_form_inherit_bill_approval" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bill.approval</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group name="bill_approval" string="Default Bill Approvers">
                    <field name="bill_approving_user_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           context="{'filter_bill_approval_user': 0}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
