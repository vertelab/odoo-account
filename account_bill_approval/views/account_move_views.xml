<odoo>

    <!-- Vendor bill form: approvers are freely selectable (T/11311) -->
    <record id="view_move_form_inherit_bill_approval" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bill.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@id='header_right_group']//field[@name='invoice_date']" position="after">
                <field name="bill_approval_state" widget="badge"
                       decoration-success="bill_approval_state == 'approved'"
                       decoration-warning="bill_approval_state == 'pending'"
                       decoration-danger="bill_approval_state == 'rejected'"
                       invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="approver_check_ok" invisible="1"/>
                <field name="to_approve" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="bill_approval" string="Approvals"
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    <field name="approving_user_ids"
                           context="{'filter_bill_approval_user': 0}">
                        <list editable="bottom">
                            <field name="user_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-warning="state == 'request'"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="date_requested" readonly="1"/>
                            <field name="date_approved" readonly="1"/>
                            <field name="date_rejected" readonly="1"/>
                            <field name="rejected_by_id" readonly="1"
                                   optional="hide"/>
                            <field name="reject_reason" readonly="1"
                                   optional="show"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_request_bill_approval" type="object"
                        string="Request Approval"
                        class="btn-primary"
                        invisible="move_type not in ('in_invoice', 'in_refund')
                                   or not approver_check_ok
                                   or state != 'draft'"/>
                <button name="action_user_approve_bill" type="object"
                        string="Approve Bill"
                        class="btn-primary"
                        invisible="not to_approve"/>
                <button name="action_user_reject_bill" type="object"
                        string="Reject"
                        class="btn-danger"
                        invisible="not to_approve"/>
            </xpath>

        </field>
    </record>

    <!-- List view: approval status column -->
    <record id="view_move_tree_inherit_bill_approval" model="ir.ui.view">
        <field name="name">account.move.list.inherit.bill.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="bill_approval_state" widget="badge"
                       decoration-success="bill_approval_state == 'approved'"
                       decoration-warning="bill_approval_state == 'pending'"
                       decoration-danger="bill_approval_state == 'rejected'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Search filter: bills waiting for me -->
    <record id="view_move_search_inherit_bill_approval" model="ir.ui.view">
        <field name="name">account.move.search.inherit.bill.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter name="filter_my_approval" string="Waiting For My Approval"
                        domain="[('to_approve', '=', True)]"/>
                <filter name="filter_bill_approval_pending" string="Approval Pending"
                        domain="[('bill_approval_state', '=', 'pending')]"/>
                <filter name="filter_bill_approval_rejected" string="Approval Rejected"
                        domain="[('bill_approval_state', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

</odoo>
