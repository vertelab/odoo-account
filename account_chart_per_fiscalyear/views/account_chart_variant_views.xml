<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_chart_variant_tree" model="ir.ui.view">
        <field name="name">account.chart.variant.tree</field>
        <field name="model">account.chart.variant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="template_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_account_chart_variant_form" model="ir.ui.view">
        <field name="name">account.chart.variant.form</field>
        <field name="model">account.chart.variant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="template_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Custom Accounts" name="custom">
                            <field name="custom_account_ids">
                                <tree editable="bottom">
                                    <field name="action"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_chart_variant" model="ir.actions.act_window">
        <field name="name">Chart Variants</field>
        <field name="res_model">account.chart.variant</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_account_chart_variant"
              parent="account.menu_finance_configuration"
              sequence="36"
              name="Chart Variants"
              action="action_account_chart_variant"/>
</odoo>
