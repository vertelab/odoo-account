<odoo>
    <record id="view_move_form_inherit_auto_reverse" model="ir.ui.view">
        <field name="name">account.move.form.inherit.auto.reverse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
               <xpath expr="//field[@name='to_check']" position="before">
                 <field name="auto_reverse_date" invisible="move_type not in ('out_invoice', 'in_invoice')"/>
                 <field name="reverse_failed" invisible="not reverse_failed"/>
                 <field name="reverse_reason" invisible="not reverse_reason"/>
               </xpath>
        </field>
    </record>
</odoo>
