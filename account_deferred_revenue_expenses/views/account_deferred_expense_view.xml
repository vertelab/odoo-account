<odoo>
    <data>

        <record model="ir.ui.view" id="view_asset_profile_extended">
            <field name="name">view_asset_profile_extended</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
            <field name="arch" type="xml">
                <field name="profile_id" position="replace">
                    <field name="profile_id" domain="[('rec_type', '=', 'asset' )]"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="account_deferred_expense_form_view">
            <field name="name">account.deferred.expense.form</field>
            <field name="model">account.asset</field>
            <field name="arch" type="xml">
                <form string="Deferred Expense">
                    <header>
                        <button name="validate" string="Confirm Expense" type="object" class="oe_highlight" invisible="state != 'draft'" />
                        <button name="set_to_draft" invisible="state not in ['open', 'close']" string="Set to Draft" type="object" groups="account.group_account_manager" />
                        <button name="remove" string="Remove" type="object" groups="account.group_account_manager" invisible="state not in ['open', 'close']" help="Deferred Expense removal." />
                        <field name="state" widget="statusbar" statusbar_visible="draft,open,close,removed" />
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active" />
                        <div class="oe_button_box" name="button_box">
                            <button name="open_entries" string="Journal Entries" type="object" class="oe_stat_button" icon="fa-bars" />
                        </div>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Expense Name"/>
                            <h1>
                                <field name="name" class="oe_inline" string="Expense Name" />
                            </h1>
                        </div>
                        <group>
                            <group id="header_left_group">
                                <field name="company_id" invisible="1" />
                                <field name="code" />
                                <field name="rec_type" invisible="1" />
                                <field name="company_id" widget="selection" groups="base.group_multi_company" />
                                <field name="currency_id" groups="base.group_multi_currency" invisible="1" />
                                <field name="move_line_check" invisible="1" />
                            </group>
                            <group id="header_right_group">
                                <field name="depreciation_base" />
                                <field name="value_depreciated" />
                                <field name="value_residual" />
                                <field name="active" invisible="1" />
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page string="General">
                                <group>
                                    <group>
                                        <field name="purchase_value" readonly="move_line_check or state != 'draft'" />
                                        <field name="date_start" readonly="state != 'draft'" string="Start Date" />
                                    </group>
                                    <group>
                                        <field name="salvage_value" readonly="state != 'draft'" />
                                        <field name="date_remove" string="Remove Date" />
                                    </group>
                                </group>
                                <group string="Other Information">
                                    <group>

                                        <!--
                                        <field name="profile_id" domain="[('rec_type', '=', 'asset' )]" string="Expense Model"/>
-->
                                        <field name="profile_id" domain="[('rec_type', '=', 'deferred_expense' )]" string="Expense Model"/>
                                        <field name="group_ids" widget="many2many_tags" string="Groups"/>
                                    </group>
                                    <group>
                                        <field name="partner_id" />
                                        <field name="analytic_distribution" groups="analytic.group_analytic_accounting" widget="analytic_distribution" />
                                    </group>
                                </group>

                                <group>
                                    <group string="Depreciation Dates">
                                        <field name="method_time" required="1" />
                                        <span class="o_label" style="color: #000; font-size: 14px;">Spread over
                                            <field name="method_number" invisible="method_time not in ['number', 'year']" required="method_time in ['number', 'year']" class="oe_inline"/>
                                            <field name="method_period" required="1" class="oe_inline"/>
                                        </span>
                                        <field name="method_end" required="method_time == 'end'" invisible="method_time in ['number']" />
                                        <field name="days_calc" />
                                        <field name="use_leap_years" invisible="days_calc" />
                                    </group>
                                    <group string="Depreciation Method">
                                        <field name="method" required="1" />
                                        <field name="method_progress_factor" invisible="method in ['linear', 'linear-limit']" required="method in ['degressive', 'degr-linear', 'degr-limit']" />
                                        <field name="prorata" readonly="method_time != 'year'" />
                                        <field name="carry_forward_missed_depreciations" />
                                    </group>
                                </group>
                            </page>
                            <page string="Depreciation Board">
                                <div>
                                    <button type="object" name="compute_depreciation_board" string="Compute" icon="fa-gears" invisible="state in ['close', 'removed']" />
                                </div>
                                <field name="depreciation_line_ids" mode="list" options="{'reload_on_button': true}">
                                    <list decoration-info="(move_check == False) and (init_entry == False)" create="false">
                                        <field name="type" />
                                        <field name="line_date" />
                                        <field name="line_days" sum="Total Days" />
                                        <field name="depreciated_value" readonly="1" />
                                        <field name="amount" />
                                        <field name="remaining_value" readonly="1" />
                                        <field name="init_entry" string="Init" />
                                        <field name="move_check" />
                                        <field name="parent_state" invisible="1" />
                                        <field name="currency_id" invisible="1" />
                                        <button name="create_move" icon="fa-cog" string="Create Move" type="object" invisible="init_entry or move_check or parent_state != 'open'" />
                                        <button name="open_move" icon="fa-folder-open-o" string="View Move" type="object" invisible="not move_check" />
                                        <button name="unlink_move" icon="fa-times" string="Delete/Reverse Move" type="object" confirm="Are you sure ?" groups="account.group_account_manager" invisible="not move_check" />
                                    </list>
                                    <form string="Expense Line">
                                        <group>
                                            <group>
                                                <field name="parent_state" invisible="1" />
                                                <field name="depreciation_base" invisible="1" />
                                                <field name="currency_id" invisible="1" />
                                                <field name="type" />
                                                <field name="name" />
                                                <field name="amount" readonly="move_check" />
                                                <field name="init_entry" readonly="move_check or type == 'create'" />
                                                <field name="move_id" />
                                                <field name="move_check" />
                                            </group>
                                            <group>
                                                <field name="line_date" readonly="move_check" />
                                                <field name="depreciated_value" readonly="1" />
                                                <field name="remaining_value" readonly="1" />
                                            </group>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="History">
                                <field name="account_move_line_ids" readonly="1">
                                    <list>
                                        <field name="date" />
                                        <field name="move_id" />
                                        <field name="journal_id" optional="show" />
                                        <field name="account_id" />
                                        <field name="partner_id" optional="show" />
                                        <field name="ref" />
                                        <field name="name" optional="hide" />
                                        <field name="debit" sum="1" />
                                        <field name="credit" sum="1" />
                                    </list>
                                </field>
                            </page>
                            <page string="Notes">
                                <field name="note" placeholder="Add an internal note here..." />
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="account_deferred_expense_view_list">
            <field name="name">account.deferred.expense.list</field>
            <field name="model">account.asset</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" string="Name" />
                    <field name="code" optional="show" />
                    <field name="rec_type" invisible="0" />
                    <field name="depreciation_base" optional="show" />
                    <field name="value_depreciated" optional="show" />
                    <field name="value_residual" optional="show" />
                    <field name="date_start" optional="show" string="Start Date" />
                    <field name="date_remove" optional="show" string="Remove Date" />
                    <field name="profile_id" optional="show" string="Expense Profile"/>
                    <field name="method" optional="hide" />
                    <field name="prorata" optional="hide" />
                    <field name="group_ids" widget="many2many_tags" optional="hide" />
                    <field name="company_id" groups="base.group_multi_company" optional="show" />
                    <field name="state" widget="badge" decoration-success="state == 'open'" decoration-warning="state == 'removed'" decoration-info="state == 'draft'" decoration-muted="state == 'close'" />
                    <field name="currency_id" invisible="1" />
                </list>
            </field>
        </record>

        <record id="account_deferred_expense_view_search" model="ir.ui.view">
            <field name="name">account.deferred.expense.search</field>
            <field name="model">account.asset</field>
            <field name="arch" type="xml">
                <search string="Deferred Expense">
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                    <filter string="Running" name="running" domain="[('state', '=', 'open')]" />
                    <filter string="Close" name="close" domain="[('state', '=', 'close')]" />
                    <filter string="Removed" name="removed" domain="[('state', '=', 'removed')]" />
                    <separator />
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                    <separator />
                    <field name="name" />
                    <field name="code" />
                    <field name="date_start" />
                    <field name="profile_id" string="Expense Profile"/>
                    <field name="group_ids" />
                    <field name="partner_id" filter_domain="[('partner_id', 'child_of', self)]" />
                    <group name="groupby">
                        <filter string="Profile" name="profile" domain="" context="{'group_by': 'profile_id'}" />
                        <filter string="Status" name="state_groupby" domain="" context="{'group_by': 'state'}" />
                        <filter string="Computation Method" name="method_groupby" domain="" context="{'group_by': 'method'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="account_deferred_expense_action" model="ir.actions.act_window">
            <field name="name">Deferred Expense</field>
            <field name="res_model">account.asset</field>
            <field name="search_view_id" ref="account_deferred_expense_view_search"/>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_deferred_expense_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_deferred_expense_form_view')})]"/>
            <field name="domain">[('rec_type', '=', 'deferred_expense')]</field>
            <field name="context">{'default_rec_type': 'deferred_expense'}</field>
        </record>

        <menuitem id="account_deferred_expense_action_menu" action="account_deferred_expense_action" parent="account.menu_finance_entries"/>

        <record id="account_deferred_income_action" model="ir.actions.act_window">
            <field name="name">Deferred Income</field>
            <field name="res_model">account.asset</field>
            <field name="search_view_id" ref="account_deferred_expense_view_search"/>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_deferred_expense_view_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_deferred_expense_form_view')})]"/>
            <field name="domain">[('rec_type', '=', 'deferred_income')]</field>
            <field name="context">{'default_rec_type': 'deferred_income'}</field>
        </record>

        <menuitem id="account_deferred_income_action_menu" action="account_deferred_income_action" parent="account.menu_finance_entries"/>


        <record id="account_asset_management.account_asset_action" model="ir.actions.act_window">
            <field name="name">Assets</field>
            <field name="res_model">account.asset</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('rec_type', '=', 'asset')]</field>
            <field name="context">{'default_rec_type': 'asset'}</field>
        </record>

        <record id="account_asset_management.account_asset_profile_action" model="ir.actions.act_window">
            <field name="name">Asset Profiles</field>
            <field name="res_model">account.asset.profile</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('rec_type', '=', 'asset')]</field>
            <field name="context">{'default_rec_type': 'asset'}</field>
        </record>

    </data>
</odoo>
