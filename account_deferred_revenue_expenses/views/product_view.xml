<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="product_normal_form_view">
            <field name="name">product.form.deferred.expense</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <!-- 19.0 replaced the Receivables/Payables pair with a single
                     "Cost and Revenue" group; anchor after the accounting group. -->
                <group name="accounting" position="after">
                    <group>
                        <field name="deferred_profile_id" string="Accrual Profile"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
