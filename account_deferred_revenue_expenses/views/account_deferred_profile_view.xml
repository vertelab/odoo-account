<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════
             DEFERRED PROFILE FORM
             ═══════════════════════════════════════════════════════════ -->
        <record model="ir.ui.view" id="account_deferred_profile_form_view">
            <field name="name">account.deferred.profile.form</field>
            <field name="model">account.deferred.profile</field>
            <field name="arch" type="xml">
                <form string="Accrual Profile">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>

                        <group>
                            <group string="General">
                                <field name="rec_type" string="Type" widget="radio"/>
                                <field name="active" invisible="1"/>
                                <field name="company_id" widget="selection"
                                       groups="base.group_multi_company"/>
                                <field name="journal_id"
                                       domain="[('type', '=', 'general'), ('company_id', '=', company_id)]"/>
                            </group>
                            <group string="Accounts">
                                <field name="account_depreciation_id" string="Periodiseringskonto"
                                       domain="[('deprecated', '=', False)]"/>
                                <field name="use_line_account" string="Hämta konto från verifikatet"/>
                                <field name="account_expense_id"
                                       string="Kostnads-/intäktskonto"
                                       invisible="use_line_account"
                                       domain="[('deprecated', '=', False)]"/>
                            </group>
                        </group>

                        <group string="Periodization Defaults">
                            <group>
                                <field name="method_period" string="Period Length"
                                       widget="radio" required="1"/>
                                <field name="method_number" string="Number of Periods"
                                       placeholder="e.g. 12"/>
                            </group>
                            <group string="Options">
                                <field name="open_asset" string="Skip Draft State"/>
                                <field name="allow_reversal" string="Allow Reversal"/>
                            </group>
                        </group>

                        <group string="Analytic Default"
                               groups="analytic.group_analytic_accounting">
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"/>
                        </group>

                        <separator string="Notes"/>
                        <field name="note" placeholder="Internal notes…"/>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             DEFERRED PROFILE LIST
             ═══════════════════════════════════════════════════════════ -->
        <record model="ir.ui.view" id="account_deferred_profile_list_view">
            <field name="name">account.deferred.profile.list</field>
            <field name="model">account.deferred.profile</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="rec_type" string="Type"/>
                    <field name="account_expense_id" optional="show"
                           string="Expense Account"/>

                    <field name="method_period" optional="show" string="Period"/>
                    <field name="method_number" optional="show" string="Periods"/>
                    <field name="journal_id" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company"
                           optional="show"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             DEFERRED PROFILE SEARCH
             ═══════════════════════════════════════════════════════════ -->
        <record model="ir.ui.view" id="account_deferred_profile_search_view">
            <field name="name">account.deferred.profile.search</field>
            <field name="model">account.deferred.profile</field>
            <field name="arch" type="xml">
                <search string="Search Accrual Profile">
                    <field name="name"/>
                    <field name="journal_id"/>
                    <separator/>
                    <filter string="Expense" name="expense"
                            domain="[('rec_type', '=', 'deferred_expense')]"/>
                    <filter string="Income" name="income"
                            domain="[('rec_type', '=', 'deferred_income')]"/>
                    <filter string="Archived" name="inactive"
                            domain="[('active', '=', False)]"/>
                    <group name="groupby">
                        <filter name="type_groupby" string="Type"
                                context="{'group_by': 'rec_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════
             ACTIONS & MENUS
             ═══════════════════════════════════════════════════════════ -->
        <record id="account_deferred_profile_action" model="ir.actions.act_window">
            <field name="name">Accrual Profiles</field>
            <field name="res_model">account.deferred.profile</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="account_deferred_profile_search_view"/>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_deferred_profile_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_deferred_profile_form_view')})]"/>
        </record>

        <menuitem id="account_deferred_profile_menu"
                  action="account_deferred_profile_action"
                  parent="account.account_account_menu"/>

        <!-- ── Configuration menu items ──────────────────────── -->
        <record id="account_deferred_expense_profile_action" model="ir.actions.act_window">
            <field name="name">Deferred Expenses Template</field>
            <field name="res_model">account.deferred.profile</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_deferred_profile_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_deferred_profile_form_view')})]"/>
            <field name="domain">[('rec_type', '=', 'deferred_expense')]</field>
            <field name="context">{'default_rec_type': 'deferred_expense'}</field>
        </record>

        <menuitem id="account_deferred_expense_template_menu"
                  action="account_deferred_expense_profile_action"
                  parent="account.menu_finance_configuration"
                  sequence="60"/>

        <record id="account_deferred_income_profile_action" model="ir.actions.act_window">
            <field name="name">Deferred Revenue Template</field>
            <field name="res_model">account.deferred.profile</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('account_deferred_profile_list_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('account_deferred_profile_form_view')})]"/>
            <field name="domain">[('rec_type', '=', 'deferred_income')]</field>
            <field name="context">{'default_rec_type': 'deferred_income'}</field>
        </record>

        <menuitem id="account_deferred_income_template_menu"
                  action="account_deferred_income_profile_action"
                  parent="account.menu_finance_configuration"
                  sequence="70"/>

    </data>
</odoo>
