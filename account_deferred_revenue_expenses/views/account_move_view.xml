<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Invoice (account.move) form ───────────────────────────
             Smart button shows the COUNT of deferred entries linked to
             this move and opens them. Creation happens from the line. -->
        <record model="ir.ui.view" id="view_move_form_extended">
            <field name="name">account.move.form.deferred</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_deferred_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            groups="account.group_account_invoice">
                        <div class="o_stat_info">
                            <field name="deferred_count" class="o_stat_value"/>
                            <span class="o_stat_text">Periodisering</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <!-- ── Periodisera icon button on each invoice line row ──────────
             Add a per-line action (shown as an icon at the end of the row, near
             Odoo's own line controls) that opens the create wizard with that
             account.move.line pre-selected (so it knows which line it is). -->
        <record model="ir.ui.view" id="view_move_form_line_periodisera">
            <field name="name">account.move.form.deferred.line_button</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">

                <!-- Product/bill lines list (invoice_tab): append an icon button as
                     the last column so it sits at the row end, before Odoo's trash. -->
                <xpath expr="//field[@name='invoice_line_ids'][1]//list" position="inside">
                    <button name="action_open_deferred_wizard"
                            type="object"
                            string="Periodisera"
                            class="btn btn-link p-0"
                            icon="fa-calendar"
                            title="Periodisera denna rad"
                            invisible="display_type in ('line_section', 'line_note')"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
