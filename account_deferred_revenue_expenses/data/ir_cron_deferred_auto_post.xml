<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily job that posts due deferred release stubs, independent of the
             month-end closing process. Posting runs through the standard engine so
             account/period locks are respected (a due stub in a closed/locked
             period is skipped, not posted). -->
        <record id="ir_cron_deferred_post_due_stubs" model="ir.cron">
            <field name="name">Deferred: post due periodisation stubs</field>
            <field name="model_id" ref="model_account_deferred"/>
            <field name="state">code</field>
            <field name="code">model._cron_post_due_stubs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
