<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Server action: bind existing journal entries to unbound depreciation
        lines on the selected assets.

        Available from the asset list view (Action > Match entries) and from
        the asset form (Action > Match entries).  It runs directly on the
        records, no wizard, and reports the result in a notification.
    -->
    <record id="action_server_asset_match_moves" model="ir.actions.server">
        <field name="name">Match entries</field>
        <field name="model_id" ref="account_asset_management.model_account_asset"/>
        <field name="binding_model_id" ref="account_asset_management.model_account_asset"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_match_moves()</field>
        <field name="help">Find existing journal entries that belong to the selected assets' depreciation lines and bind them. Lines that already have an entry are skipped.</field>
    </record>

</odoo>
