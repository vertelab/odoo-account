#: code:addons/account_asset_change/wizard/account_asset_change.p.py:0
#: code:addons/account_asset_change/wizard/account_asset_change.py:0
msgid ""
"%s Future entries will be recomputed to depreciate the asset following the "
"changes."
msgstr ""
"%s Framtida poster kommer att räknas om för att skriva av tillgången efter "
"ändringarna."

#. module: account_asset_change
#. odoo-python
#: code:addons/account_asset_change/wizard/account_asset_change.p.py:0
#: code:addons/account_asset_change/wizard/account_asset_change.py:0
msgid ""
"A credit journal entry will be posted for the old analytic accounts and a "
"new with the new accounts.Future entries will be recomputed to use the new "
"analytic account distribution"
msgstr ""
"En kreditjournalpost kommer att bokföras för de gamla analytiska kontona "
"och en ny med de nya kontona. Framtida poster kommer att räknas om för att "
"använda den nya analytiska kontofördelningen"

#. module: account_asset_change
#. odoo-python
#: code:addons/account_asset_change/wizard/account_asset_change.p.py:0
#: code:addons/account_asset_change/wizard/account_asset_change.py:0
msgid ""
"A depreciation entry will be posted on and including the date %(date)s. <br/"
"> %(extra_text)s Future entries will be recomputed to depreciate the asset "
"following the changes."
msgstr ""
"En avskrivningspost kommer att bokföras från och med datumet %(date)s. <br/"
"> %(extra_text)s Framtida poster kommer att räknas om för att skriva av "
"tillgången efter ändringarna."

#. module: account_asset_change
#. odoo-python
#: code:addons/account_asset_change/wizard/account_asset_change.p.py:0
#: code:addons/account_asset_change/wizard/account_asset_change.py:0
msgid ""
"A depreciation entry will be posted on and including the date %(date)s.<br/"
"> A disposal entry will be posted on the %(account_type)s account "
"<b>%(account)s</b>."
msgstr ""
"En avskrivningspost kommer att bokföras från och med datumet %(date)s.<br/> "
"En avyttringspost kommer att bokföras på kontot %(account_type)s "
"<b>%(account)s</b>."

#. module: account_asset_change
#. odoo-python
#: code:addons/account_asset_change/wizard/account_asset_change.p.py:0
#: code:addons/account_asset_change/wizard/account_asset_change.py:0
msgid ""
"A depreciation entry will be posted on and including the date %(date)s.<br/"
"> A second entry will neutralize the original income and post the  outcome "
"of this sale on account <b>%(account)s</b>."
msgstr ""
"En avskrivningspost kommer att bokföras från och med datumet %(date)s.<br/> "
"En andra post kommer att neutralisera den ursprungliga inkomsten och "
"bokföra resultatet av denna försäljning på konto <b>%(account)s</b>."

