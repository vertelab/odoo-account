<odoo>

    <record model="ir.ui.view" id="asset_relink_move_form">
        <field name="name">asset.relink.move.form</field>
        <field name="model">asset.relink.move</field>
        <field name="arch" type="xml">
            <form string="Re-link asset">
                <group>
                    <field name="move_id"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                </group>
                <field name="warning" nolabel="1" colspan="2"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="move_line_id" column_invisible="1"/>
                        <field name="name"/>
                        <field name="account_id"/>
                        <field name="debit" sum="Debit"/>
                        <field name="credit" sum="Credit"/>
                        <field name="current_asset_id"/>
                        <field name="new_asset_id"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Apply"
                            type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
