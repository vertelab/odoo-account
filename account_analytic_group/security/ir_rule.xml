<odoo>
    <record id="analytic_account_group_rule" model="ir.rule">
        <field name="name">Analytic Account: User can only see accounts from their groups</field>
        <field name="model_id" ref="analytic.model_account_analytic_account"/>
        <field name="domain_force">[
            '|',
                ('group_id', '=', False),
                ('group_id', 'in', user.groups_id.ids)
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>