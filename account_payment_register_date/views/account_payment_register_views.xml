<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_payment_register_form_inherit_date" model="ir.ui.view">
            <field name="name">account.payment.register.form.inherit.date</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id"
                   ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">

                <!-- Move payment_date from its current position -->
                <xpath expr="//field[@name='payment_date']" position="replace"/>

                <!-- Insert payment_date after communication (memo) -->
                <xpath expr="//field[@name='communication']" position="after">
                    <field name="payment_date"
                           string="Payment Date"
                           help="Date the payment is made. Defaults to the invoice due date."/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
