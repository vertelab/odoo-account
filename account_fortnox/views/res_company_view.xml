<?xml version="1.0"?>
<odoo>
	<record id="view_res_company_form_fortnox" model="ir.ui.view">
		<field name="name">view.res.company.form.fortnox.inherit</field>
		<field name="model">res.company</field>
		<field name="inherit_id" ref="base.view_company_form" />
		<field name="arch" type="xml">
			<xpath expr="//page[@name='general_info']" position="after">
				<page string="FortNox Integration">
					<button name="fortnox_auth_open_link" string="Authorize with Fortnox" type="object" class="oe_highlight"/>
					<group>
						<field name="fortnox_authorization_code"/>
						<field name="fortnox_client_id"/>
						<field name="fortnox_client_secret"/>
					</group>
				</page>
			</xpath>
		</field>
	</record>

        
	<record id="view_attachment_form_inherit_fortnox" model="ir.ui.view">
		<field name="name">ir.attachment.view.form.inherit.fortnox</field>
		<field name="model">ir.attachment</field>
		<field name="inherit_id" ref="base.view_attachment_form"/>
		<field name="arch" type="xml">
			<xpath expr="//group[@name='description_group']" position="after">
				<group name="fortnox_info" string="Fortnox Info" invisible="not fortnox_file_ref">
					<field name="fortnox_file_ref"/>
					<field name="fortnox_file_archive_id"/>
					<field name="fortnox_file_path"/>
					<field name="fortnox_file_url"/>
				</group>
			</xpath>
		</field>
	</record>

</odoo>



