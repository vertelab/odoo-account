	<record id="view_attachment_form_inherit_fortnox" model="ir.ui.view">
		<field name="name">ir.attachment.view.form.inherit.fortnox</field>
		<field name="model">ir.attachment</field>
		<field name="inherit_id" ref="base.view_attachment_form"/>
		<field name="arch" type="xml">
			<xpath expr="//group[@name='description_group']" position="after">
				<group name="fortnox_info" string="Fortnox Info" invisible="not fortnox_file_ref">
					<field name="fortnox_file_ref"/>
					<field name="fortnox_file_archive_id"/>
					<field name="fortnox_file_path"/>
					<field name="fortnox_file_url"/>
				</group>
			</xpath>
		</field>
	</record>

