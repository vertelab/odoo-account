<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_send_inherit_account_wizard_form_fortnox" model="ir.ui.view" >
        <field name="name">account.move.send.form.inherited.fortnox</field>
        <field name="model">account.move.send</field>
        <field name="inherit_id" ref="account.account_move_send_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']/div[@name='standard_options']/div[@name='option_send_mail']" position="after">
                <div name="option_fortnox">
                    <field name="is_fortnox" />
                    <b><label for="is_fortnox"/></b>
                </div>
            </xpath>
            <footer>
                <button string="Send" name="send_and_print_action" type="object" class="send_and_print btn-primary o_mail_send"/>
            </footer>
        </field>
    </record>

    <record id="view_account_invoice_fortnox_filter" model="ir.ui.view">
        <field name="name">account.invoice.filter.fortnox.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="fortnox_ref"/>
            </field>
        </field>
    </record>

    <record id="account_invoice_form_inherit" model="ir.ui.view" >
        <field name="name">account_invoice_form_inherit_fortnox</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
			<xpath expr="//button[@id='account_invoice_payment_btn']" position="before">
				<button class="oe_highlight" string="Send To Fortnox" type="object" invisible="move_type != 'out_invoice' or state != 'posted' or is_sent_to_fortnox" name="sync_fortnox"/>
				<button string="Send To Fortnox" type="object" name="sync_fortnox" invisible="move_type != 'out_invoice' or state != 'posted' or not is_sent_to_fortnox"/>
			</xpath>

            <notebook position="inside">
				<page id="fortnox_tab" name="fortnox_tab" string="Fortnox Info" invisible="move_type != 'out_invoice' and not is_sent_to_fortnox">
					<group>
                        <field name="is_sent_to_fortnox" invisible="move_type != 'out_invoice'"/>
                        <field name="fortnox_ref"/>
                        <field name="fortnox_response" groups="base.group_no_one"/>
                        <field name="fortnox_status" invisible="1"/>
                    </group>
				</page>
			</notebook>
        </field>
    </record>
</odoo>
