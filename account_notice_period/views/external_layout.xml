<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18's web.external_layout_standard no longer has the
        `o_standard_footer` + `ul.list-inline.mb4` structure. The footer is a
        flex container with `div.o_footer_content`. Insert our lines there.
    -->
    <template id="external_layout_standard_inherit" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('o_footer_content')]" position="inside">
            <div class="o_footer_notice_period text-muted small">
                <!-- Add account.move narration -->
                <t t-if="o and o._name == 'account.move' and o.narration">
                    <div><span class="o_force_ltr" t-field="o.narration"/></div>
                </t>
                <!-- Add payment term notice period -->
                <t t-if="o and o._name == 'account.move' and o.invoice_payment_term_id and o.invoice_payment_term_id.notice_period_note">
                    <div><span class="o_force_ltr" t-field="o.invoice_payment_term_id.notice_period_note"/></div>
                </t>
                <t t-if="o and o._name == 'sale.order' and o.payment_term_id and o.payment_term_id.notice_period_note">
                    <div><span class="o_force_ltr" t-field="o.payment_term_id.notice_period_note"/></div>
                </t>
                <!-- Add Swedish company registry -->
                <t t-if="company and company.company_registry">
                    <div>Organization number: <span t-field="company.company_registry"/></div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
