<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_term_form_inherit_notice" model="ir.ui.view">
            <field name="name">account.payment.term.form.inherit.notice</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='note']" position="after">
                    <label for="notice_period_note"/>
                    <field name="notice_period_note" placeholder="Notice period explanation..."/>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>


