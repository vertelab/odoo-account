<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form - invoice multi currency</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!-- Odoo 18 uses <block>/<setting>, not a bare <div> under the id. -->
                <block id="invoicing_settings" position="inside">
                    <setting id="invoice_multi_currency_ids_setting"
                             help="Show the invoice totals in these currencies as well">
                        <label for="invoice_multi_currency_ids" string="Invoice Multi-Currencies"/>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="invoice_multi_currency_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </field>
        </record>
    </data>
</odoo>
