<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_import_account_move_wizard_form" model="ir.ui.view">
            <field name="name">import.account.move.wizard.form</field>
            <field name="model">import.account.move.wizard</field>
            <field name="arch" type="xml">
                <form string="Import PDF Simple Config">
                    <group>
                        <field name="account_move_file" filename="account_move_filename"/>
                    </group>
                    <footer>
                        <button name="action_import_account_move" string="Import Account Move" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_import_account_move_wizard" model="ir.actions.act_window">
            <field name="name">Import Account</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">import.account.move.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_import_account_move_wizard" action="action_import_account_move_wizard" name="Import Account Move" parent="account.account_invoicing_menu" sequence="4"/>
    </data>
</odoo>