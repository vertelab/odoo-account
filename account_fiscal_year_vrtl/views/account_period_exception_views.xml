<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_period_exception_tree" model="ir.ui.view">
        <field name="name">account.period.exception.tree</field>
        <field name="model">account.period.exception</field>
        <field name="arch" type="xml">
            <tree decoration-muted="active == False">
                <field name="period_id"/>
                <field name="user_id"/>
                <field name="end_datetime"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'revoked'"/>
                <field name="create_uid"/>
            </tree>
        </field>
    </record>

    <record id="view_account_period_exception_form" model="ir.ui.view">
        <field name="name">account.period.exception.form</field>
        <field name="model">account.period.exception</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object"
                            string="Revoke" class="oe_highlight"
                            invisible="state != 'active'"
                            confirm="Revoke this exception? The user will no longer be able to post in this period."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired,revoked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="period_id"
                                   domain="[('state', '=', 'done')]"/>
                            <field name="user_id"
                                   help="Leave empty to grant to all users"/>
                            <field name="end_datetime"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="create_uid"/>
                            <field name="revoke_uid"
                                   invisible="state not in ('revoked',)"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="reason" nolabel="1"
                               placeholder="Why is this exception needed? E.g. Auditor adjustment requested 2026-04-15"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_period_exception_search" model="ir.ui.view">
        <field name="name">account.period.exception.search</field>
        <field name="model">account.period.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="period_id"/>
                <field name="user_id"/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Expired" name="expired"
                        domain="[('state', '=', 'expired')]"/>
            </search>
        </field>
    </record>

    <record id="action_account_period_exception" model="ir.actions.act_window">
        <field name="name">Period Exceptions</field>
        <field name="res_model">account.period.exception</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_account_period_exception"
              parent="account.menu_finance_entries"
              sequence="85"
              name="Period Exceptions"
              action="action_account_period_exception"/>
</odoo>
