<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 18: settings-vyn anvander <app>/<block>/<setting>, inte
         div[hasclass('settings')]. Omskriven 2026-10-29 (template_base-bygget). -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fiscal.year</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Fiscal Year &amp; Periods" id="fiscal_year_settings">
                    <setting id="period_closing_date_setting"
                             string="Default Period Closing Date"
                             help="Periods with this closing date will be auto-closed when the server action 'Close Past-Due Periods' is run.">
                        <field name="period_closing_date"/>
                    </setting>
                    <setting id="close_period_hash_lock_setting"
                             string="Hash-Lock on Period Close"
                             help="When enabled, all posted moves will be hash-locked (made inalterable) when their period is closed. Warning: this is destructive!">
                        <field name="close_period_hash_lock"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
