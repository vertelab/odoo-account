<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiscal Year Tree View -->
    <record id="view_account_fiscal_year_tree" model="ir.ui.view">
        <field name="name">account.fiscal.year.tree</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- Fiscal Year Form View -->
    <record id="view_account_fiscal_year_form" model="ir.ui.view">
        <field name="name">account.fiscal.year.form</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_period1" type="object"
                            string="Create Monthly Periods"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" type="object"
                            string="Re-Open"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"
                           statusbar_colors="{'done': 'success'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Fiscal Year Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Periods" name="periods">
                            <field name="period_ids" context="{'default_fiscalyear_id': id}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="date_start"/>
                                    <field name="date_stop"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fiscal Year Search View -->
    <record id="view_account_fiscal_year_search" model="ir.ui.view">
        <field name="name">account.fiscal.year.search</field>
        <field name="model">account.fiscal.year</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Open" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Closed" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="company" domain="[]"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter string="State" name="state_group" domain="[]"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_account_fiscal_year" model="ir.actions.act_window">
        <field name="name">Fiscal Years</field>
        <field name="res_model">account.fiscal.year</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_account_fiscal_year"
              parent="account.menu_finance_configuration"
              sequence="30"
              name="Fiscal Years"
              action="action_account_fiscal_year"/>
</odoo>
