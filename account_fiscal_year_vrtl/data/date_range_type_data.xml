<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Generic date range types — universal concepts, not Sweden-specific -->

        <record id="date_range_type_fiscalyear" model="date.range.type">
            <field name="name">Fiscal Year</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">'FY' + str(context['date'].year)</field>
        </record>

        <record id="date_range_type_quarter" model="date.range.type">
            <field name="name">Quarter</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">'Q' + str((context['date'].month - 1) // 3 + 1) + '-' + str(context['date'].year)</field>
        </record>

        <record id="date_range_type_month" model="date.range.type">
            <field name="name">Month</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">context['date'].strftime('%Y-%m')</field>
        </record>

        <record id="date_range_type_week" model="date.range.type">
            <field name="name">Week</field>
            <field name="allow_overlap" eval="False"/>
            <field name="name_expr">context['date'].strftime('%Y-W%V')</field>
        </record>
    </data>
</odoo>
