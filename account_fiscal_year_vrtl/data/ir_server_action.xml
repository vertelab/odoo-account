<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Server action for period closing — replaces cron for flexibility -->
        <record id="ir_server_action_close_periods" model="ir.actions.server">
            <field name="name">Close Past-Due Periods</field>
            <field name="model_id" ref="model_account_period"/>
            <field name="state">code</field>
            <field name="code">
                model._cron_close_account_period()
            </field>
        </record>
    </data>
</odoo>
