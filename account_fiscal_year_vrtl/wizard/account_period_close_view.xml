<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_period_close" model="ir.ui.view">
        <field name="name">account.period.close.form</field>
        <field name="model">account.period.close</field>
        <field name="arch" type="xml">
            <form string="Close Period">
                <group>
                    <p class="oe_grey">
                        Are you sure you want to close the selected period(s)?
                        Once closed, no moves can be created or modified in this period.
                    </p>
                    <field name="sure"/>
                </group>
                <footer>
                    <button name="data_save" type="object"
                            string="Close Period" class="oe_highlight"
                            invisible="sure == False"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_close_account_period_journal" model="ir.ui.view">
        <field name="name">close.account.period.journal.form</field>
        <field name="model">close.account.period.journal</field>
        <field name="arch" type="xml">
            <form string="Close Period Journal">
                <group>
                    <p class="oe_grey">
                        Are you sure you want to close the selected journal entry?
                    </p>
                    <field name="sure"/>
                </group>
                <footer>
                    <button name="data_save" type="object"
                            string="Close" class="oe_highlight"
                            invisible="sure == False"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions: <act_window> togs bort i Odoo 17+ — anvand ir.actions.act_window-records. Rattat 2026-10-29. -->

    <record id="action_account_period_close" model="ir.actions.act_window">
        <field name="name">Close Period</field>
        <field name="res_model">account.period.close</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_period"/>
        <field name="binding_view_types">list,form</field>
    </record>
    <record id="action_close_account_period_journal" model="ir.actions.act_window">
        <field name="name">Close Journal</field>
        <field name="res_model">close.account.period.journal</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_period_journal"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
