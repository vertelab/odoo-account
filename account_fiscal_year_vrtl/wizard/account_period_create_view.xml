<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_period_create_wizard" model="ir.ui.view">
        <field name="name">account.period.create.wizard.form</field>
        <field name="model">account.period.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Fiscal Year &amp; Periods">
                <group>
                    <field name="fy_name"/>
                    <field name="date_start"/>
                    <field name="date_stop"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="create_period1" type="object"
                            string="Create Monthly Periods" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_period_create_wizard" model="ir.actions.act_window">
        <field name="name">Create Fiscal Year &amp; Periods</field>
        <field name="res_model">account.period.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
