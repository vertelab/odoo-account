<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_fiscalyear_close" model="ir.ui.view">
        <field name="name">account.fiscalyear.close.form</field>
        <field name="model">account.fiscalyear.close</field>
        <field name="arch" type="xml">
            <form string="Close Fiscal Year">
                <group>
                    <p class="oe_grey">
                        Are you sure you want to close the selected fiscal year(s)?
                        All periods must be closed first.
                    </p>
                    <field name="sure"/>
                </group>
                <footer>
                    <button name="data_save" type="object"
                            string="Close Fiscal Year" class="oe_highlight"
                            attrs="{'invisible': [('sure', '=', False)]}"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_account_fiscalyear_close"
                name="Close Fiscal Year"
                res_model="account.fiscalyear.close"
                view_mode="form"
                target="new"
                binding_model="account.fiscal.year"
                binding_view_types="list,form"/>
</odoo>
