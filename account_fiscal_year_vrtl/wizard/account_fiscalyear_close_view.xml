<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_fiscalyear_close" model="ir.ui.view">
        <field name="name">account.fiscalyear.close.form</field>
        <field name="model">account.fiscalyear.close</field>
        <field name="arch" type="xml">
            <form string="Close Fiscal Year">
                <group>
                    <p class="oe_grey">
                        Are you sure you want to close the selected fiscal year(s)?
                        All periods must be closed first.
                    </p>
                    <field name="sure"/>
                </group>
                <footer>
                    <button name="data_save" type="object"
                            string="Close Fiscal Year" class="oe_highlight"
                            invisible="sure == False"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_fiscalyear_close" model="ir.actions.act_window">
        <field name="name">Close Fiscal Year</field>
        <field name="res_model">account.fiscalyear.close</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_fiscal_year"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
