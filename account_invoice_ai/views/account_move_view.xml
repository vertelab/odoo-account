<odoo>
    <data>
        <record id="ai_quest_account_move_form_view" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[@name='button_box']" position="inside">
                    <field name="ai_session_id" invisible="1"/>
                    <button name="action_view_ai_session" class="oe_stat_button " type="object" icon="fa-spinner" string="AI Session" invisible="not ai_session_id"/>
                </xpath>
                <widget name="web_ribbon" position="after">
                    <widget name="web_ribbon" title="Duplicate" bg_color="bg-danger" invisible="not to_check_duplicate or payment_state != 'not_paid'"/>
                    <widget name="web_ribbon" title="Check Period" bg_color="bg-danger" invisible="not to_check_period or payment_state != 'not_paid' or to_check_duplicate"/>
                </widget>

                <button name="action_post" position="after">
                    <button groups="account.group_account_user" name="re_update_move_lines" type="object" class="btn btn-primary" confirm="Are you sure you want to add scanned lines?" string="Add Scanned Lines" invisible="state != 'draft' or not ai_session_id"/>
                    <button groups="account.group_account_user" name="clear_move_lines" type="object" class="btn btn-danger" string="Clear Lines" confirm="Are you sure you want to clear the lines?" invisible="state != 'draft' or not ai_session_id"/>
                    <button groups="account.group_account_user" name="action_rerun" type="object" class="btn btn-warning" string="Re-run" confirm="Are you sure you want to rerun?" invisible="state != 'draft' or not ai_session_id"/>
                </button>
                
                    <xpath expr="//field[@name='checked']" position="after">
                    <field name="to_check_duplicate"/>
                    <field name="to_check_period"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
