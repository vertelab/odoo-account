<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_report_form_dynamic" model="ir.ui.view">
        <field name="name">account.report.form.dynamic</field>
        <field name="model">account.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_dynamic_report" 
                            string="View Report" 
                            type="object" 
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="filter_date_range"/>
                            <field name="filter_period_comparison"/>
                            <field name="filter_unfold_all"/>
                            <field name="filter_hide_0_lines"/>
                        </group>
                    </group>
                    <group string="Report Lines">
                        <field name="line_ids">
                            <list>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="parent_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_report_tree_dynamic" model="ir.ui.view">
        <field name="name">account.report.list.dynamic</field>
        <field name="model">account.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
</odoo>
