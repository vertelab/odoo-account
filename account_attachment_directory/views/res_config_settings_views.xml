<?xml version="1.0"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Directory Watch" id="directory_watch">
                    <setting id="account_directory_watch" help="Add the path of the directory you want watched.">
                        <field name="account_attachment_directory" string="Account Attachment Directory"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
