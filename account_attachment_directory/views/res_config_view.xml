<?xml version="1.0"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='accounting']" position="inside">
                <div class="row">
                    <div class="col-lg-6">
                        <field name="account_attachment_directory" string="Account Attachment Directory"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
