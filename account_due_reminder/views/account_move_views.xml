<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add reminder info to invoice form -->
        <record id="view_move_form_payment_reminder" model="ir.ui.view">
            <field name="name">account.move.form.payment.reminder</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add button to stat button area -->
                <div name="button_box" position="inside">
                    <button type="object"
                            name="action_send_reminders"
                            class="oe_stat_button"
                            icon="fa-bell"
                            groups="account.group_account_invoice">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="reminder_count"/>
                            </span>
                            <span class="o_stat_text">Reminders Sent</span>
                        </div>
                    </button>
                </div>

                <!-- Add reminder fields after payment terms -->
                <field name="invoice_payment_term_id" position="after">
                    <field name="next_reminder_date"
                           readonly="1"
                           groups="account.group_account_invoice"/>
                    <field name="last_reminder_id"
                           readonly="1"
                           invisible="not last_reminder_id"
                           groups="account.group_account_invoice"/>
                </field>
            </field>
        </record>
    </data>
</odoo>