<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_account_payment_plan_tree" model="ir.ui.view">
        <field name="name">account.payment.plan.list</field>
        <field name="model">account.payment.plan</field>
        <field name="arch" type="xml">
            <list string="Payment Plan" >
                <field name="account_move_id"/>
                <field name="start_date"/>
                <field name="duration"/>
                <field name="end_date"/>
                <field name="untaxed_amount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                <field name="contract_id"/>
                <field name="tax_id"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_account_payment_plan_form" model="ir.ui.view">
        <field name="name">account.payment.plan.form</field>
        <field name="model">account.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plan">
<!--                <header>-->
<!--                    <field name="state" widget="statusbar" statusbar_visible="active,inactive"/>-->
<!--                    <button name="action_mark_as_loss" string="Mark as Loss" class="btn btn-primary" type="object"/>-->
<!--                </header>-->
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="duration"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="account_move_id"/>
                            <field name="untaxed_amount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="tax_id"/>
                            <field name="contract_id" invisible="not contract_id"/>
                            <field name="feared_loss_entry" invisible="not feared_loss_entry"/>
                            <field name="actual_loss_move" invisible="not actual_loss_move"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_account_payment_plan_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.plan.wizard.form</field>
        <field name="model">account.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plan">
                <sheet>
                    <group>
                        <group>
                            <field name="account_move_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="start_date"/>
                            <field name="duration"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="untaxed_amount" widget='monetary' options="{'currency_field': 'currency_id'}"/>
                            <field name="tax_id"/>
                            <field name="contract_id" invisible="not contract_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_payment_plan" string="Create Payment Plan" type="object" groups="account.group_account_invoice" class="btn btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>



    <record id="action_account_account_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plan</field>
        <field name="res_model">account.payment.plan</field>
        <field name="search_view_id" ref="view_account_payment_reminder_filter"/>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define follow-up reminders and their related actions
            </p><p>
                For each step, specify the actions to be taken and delay in days. It is
                possible to use print and e-mail templates to send specific messages to
                the customer.
            </p>
      </field>
    </record>

    <menuitem action="action_account_account_payment_plan" id="account_payment_reminder_menu" parent="account.account_invoicing_menu" name="Payment Reminder" groups="account.group_account_manager" sequence="2"/>

</odoo>
