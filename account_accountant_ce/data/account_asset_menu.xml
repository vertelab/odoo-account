<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Parent the Assets menu under this module's accounting root.

        account_asset_management (OCA) declares menu_finance_assets as a child
        of account.menu_finance. That record is hidden from the app switcher by
        this module (web_icon cleared), so anything still parented to it becomes
        invisible — Assets would vanish from the UI along with the root.

        account_asset_management is a hard dependency of this module, so the
        menu xmlid always resolves. If the dependency is ever removed this
        record fails loudly instead of silently doing nothing, which is the
        behaviour we want.

        This file is loaded AFTER data/account_accountant_data.xml; both
        reparent the same menu and the last writer wins, so keep them
        consistent.
    -->
    <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
</odoo>
