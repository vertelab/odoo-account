<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Restore the parent of the Assets menu.

        account_asset_management (OCA) declares menu_finance_assets as a child
        of account.menu_finance. The old implementation of this module
        reparented it onto its own root menu, and when that root was dropped
        the menu was left with parent_id = False, an orphan root.

        account_asset_management is a hard dependency of this module, so the
        menu xmlid always resolves. If the dependency is ever removed this
        record fails loudly instead of silently doing nothing, which is the
        behaviour we want.
    -->
    <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu">
        <field name="parent_id" ref="account.menu_finance"/>
    </record>
</odoo>
