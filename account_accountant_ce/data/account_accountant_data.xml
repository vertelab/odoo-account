<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Present Community's accounting as "Accounting" (as in Enterprise).

        Odoo CE ships one accounting app: the root menu account.menu_finance,
        named "Invoicing". Enterprise calls the same app "Accounting". This
        module makes CE read as Accounting without changing what the app does.

        HOW: a dedicated root menu, not a rename
        The module owns its own root menu (menu_accounting) and moves every
        account sub-menu onto it. account.menu_finance is hidden from the app
        switcher by clearing its web_icon.

        Why not simply rename account.menu_finance in place? Because the name
        is a translated jsonb field and the last writer wins. Core's
        account/sv.po and account's own en_GB value both write to that record,
        so a rename here is silently overwritten on any language whose
        translation is loaded later. A root menu this module owns has no
        competing writer, so the name holds on every language.

        WHY THE HIDDEN ROOT IS SAFE
        A root menu with no web_icon is not shown in the app switcher, so
        account.menu_finance disappears from the UI even though the record
        remains. That is the whole trick — and it is also the fragile part:

          * Every menu that points at account.menu_finance must be reparented
            here, or it stays under an invisible root and vanishes with it.
            The list below is exhaustive as of 18.0.1.2.0: seven account menus
            and OCA account_asset_management's Assets. A new module that hangs a
            menu there will disappear until it is added here.

          * The record itself is NOT deleted and NOT deactivated. Deactivating
            a core menu is undone by the next upgrade of `account`, and
            deleting it would cascade to anything still attached.

        The reparenting is idempotent: it runs on every upgrade and repairs a
        database where a module re-attached its menu to account.menu_finance.
    -->

    <!-- 1. Our own root menu, with the icon so it appears in the app switcher. -->
    <menuitem
        id="menu_accounting"
        name="Accounting"
        web_icon="account,static/description/icon.png"
        sequence="60"
    />

    <!-- 2. Hide core's root from the app switcher. The record stays. -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="web_icon" eval="False"/>
    </record>

    <!--
        3. Move every child of account.menu_finance onto our root.

        Deleting or hiding a parent does not clear parent_id on its children —
        Odoo never resets a field whose XML record disappears. So each child is
        named explicitly. Keep this list in sync with the modules that target
        account.menu_finance.
    -->
    <record id="account.menu_board_journal_1" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
    <record id="account.menu_finance_payables" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>

    <!-- OCA account_asset_management declares Assets under account.menu_finance. -->
    <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting"/>
    </record>

</odoo>
