<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rename the accounting app category from "Invoicing" to "Accounting".

        `base` ships this category as `name="Invoicing"` (see
        base/data/ir_module_category_data.xml). Renaming it here is what makes
        the Apps list and the user form show "Accounting".

        The group definitions that used to live in this file are deliberately
        NOT here. They overwrote the Community group architecture defined in
        account/security/account_security.xml:

          * group_account_readonly and group_account_user are `category_id =
            base.module_category_hidden` in Community. Overwriting them with
            this category made them selectable in the user form, exposing
            groups that Community intentionally hides.
          * group_account_user lost its `group_account_basic` implication,
            silently changing what "full accounting" grants.
          * group_account_manager had `implied_ids` rewritten with a (3, ...)
            unlink of group_account_invoice, removing an implication that
            Community relies on.

        None of those groups are referenced by this module. They belong to
        `account` and must be left alone.
    -->
    <record model="ir.module.category" id="base.module_category_accounting_accounting">
        <field name="name">Accounting</field>
    </record>
</odoo>
