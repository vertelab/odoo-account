<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Change settings app title from "Invoicing" to "Accounting" -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.accountant.ce</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="attributes">
                <attribute name="string">Accounting</attribute>
            </xpath>
        </field>
    </record>
</odoo>
