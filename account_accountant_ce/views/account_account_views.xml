<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Show the "Allow Reconciliation" flag on the account form.

        Community shows `reconcile` in the chart-of-accounts list view but not
        on `account.account`'s form. This adds it to the form, next to the
        other accounting flags, using the same widget and visibility rule as
        the core list view:

            <field name="reconcile" widget="boolean_toggle"
                   invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')"/>

        The view id is module-prefixed (`account_accountant_ce.`) so it does
        not shadow or collide with any view id owned by `account`.
    -->
    <record id="view_account_form_reconcile" model="ir.ui.view">
        <field name="name">account.account.form.reconcile</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='internal_group']" position="after">
                <field name="reconcile" widget="boolean_toggle"
                       invisible="account_type in ('asset_cash', 'liability_credit_card', 'off_balance')"/>
            </xpath>
        </field>
    </record>
</odoo>
