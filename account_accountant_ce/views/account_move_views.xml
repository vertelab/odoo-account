<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Show the inalterability hash on journal entries.

        Community keeps `account.move.inalterable_hash` on the form but always
        `invisible="1"` (account/views/account_move_views.xml). This surfaces
        it in the "Other Info" page for developers (`base.group_no_one`), which
        is what makes the hash verifiable from the UI.

        Both pages are covered because the "Other Info" page is split by move
        type: `other_tab` for invoices/refunds and `other_tab_entry` for
        miscellaneous entries.

        The view id is module-prefixed so it cannot shadow a view owned by
        `account`.
    -->
    <record id="view_move_form_inalterable_hash" model="ir.ui.view">
        <field name="name">account.move.form.inalterable.hash</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                <field name="inalterable_hash" groups="base.group_no_one"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//field[@name='company_id']" position="after">
                <field name="inalterable_hash" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>
</odoo>
