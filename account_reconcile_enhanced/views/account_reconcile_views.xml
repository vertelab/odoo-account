<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Enhanced search view for account.move.line reconciliation -->
    <record id="view_account_move_line_reconcile_search" model="ir.ui.view">
        <field name="name">account.move.line.reconcile.search</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_reconcile_oca.view_move_line_reconcile_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="reconcile_model_id"
                       string="Reconciliation Model"
                       optional="show"/>
            </field>
            <filter name="unreconciled" position="after">
                <filter string="Reconcile Models Applied"
                        domain="[('reconcile_model_id', '!=', False)]"
                        name="with_reconcile_model"
                        help="Journal items created by reconciliation models"/>
            </filter>
        </field>
    </record>

    <!-- Add reconcile_model_id to move line tree/form views -->
    <record id="view_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="reconcile_model_id"
                       optional="hide"
                       string="Reco Model"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_form_inherit" model="ir.ui.view">
        <field name="name">account.move.line.form.inherit.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="reconcile_model_id"/>
            </field>
        </field>
    </record>

    <!-- Bank Fee fields on reconcile model form -->
    <record id="view_account_reconcile_model_form_fee" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.fee</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account_reconcile_model_oca.view_account_reconcile_model_form"/>
        <field name="arch" type="xml">
            <group name="matching" position="inside">
                <group string="Bank Fee Detection" colspan="2"
                       attrs="{'invisible': [('rule_type', '!=', 'writeoff_suggestion')]}">
                    <field name="is_fee_model"
                           string="Bank Fee Model"
                           help="Automatically apply when a small residual remains on incoming deposits."/>
                    <field name="fee_threshold"
                           string="Fee Threshold (%)"
                           attrs="{'invisible': [('is_fee_model', '=', False)], 'required': [('is_fee_model', '=', True)]}"
                           help="Maximum fee percentage of the deposit. The model triggers when residual is below this threshold."/>
                </group>
            </group>
        </field>
    </record>

</odoo>
