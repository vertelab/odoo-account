<?xml version="1.0"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[@id='invoicing_settings']" position="after">
                <block title="Account Period" id="account_period">
                    <setting id="account_directory_watch" help="Account Period Closing Date.">
                        <field name="period_closing_date" string="Account Period Closing Date"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>