<odoo>
    <data>
        <record id="res_partner_form_view_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                
                <field name="category_id" position="after">
                    <field name="is_enable_banking_api"/>
                </field>

                <xpath expr="//notebook" position="inside">
                    <page string="Enable Banking" name="enable_baking_settings" invisible="not is_enable_banking_api">
                        <group>
                            <group>
                                <field name="enable_banking_api_url"/>
                                <field name="enable_banking_application_id"/>
                                <field name="enable_banking_redirect_url"/>
                                <field name="enable_banking_private_key" 
                                    widget="binary" 
                                    filename="enable_banking_private_key_filename"/>
                                <field name="enable_banking_private_key_filename" invisible="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>