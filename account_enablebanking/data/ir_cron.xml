<odoo>
    <data>
        <record model="ir.cron" id="enable_banking_transaction_sync">
            <field name="name">Sync Enable Banking Transactions</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="account_enablebanking.model_account_journal"/>
            <field name="code">model._cron_sync_transactions()</field>
            <field name="state">code</field>
            <field name="active" eval="True"/>
        </record>
        <record model="ir.cron" id="enable_banking_payment_status_check">
            <field name="name">Check Enable Banking Payment Status</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="model_id" ref="account_enablebanking.model_enable_banking_payment"/>
            <field name="code">model._cron_check_payment_status()</field>
            <field name="state">code</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>