<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_loan_template_tree" model="ir.ui.view">
        <field name="name">account.loan.template.list</field>
        <field name="model">account.loan.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="is_leasing" />
                <field name="rate" optional="hide" />
                <field name="loan_amount" optional="hide" />
                <field name="start_date" optional="hide" />
            </list>
        </field>
    </record>

    <record id="account_loan_template_form" model="ir.ui.view">
        <field name="name">account.loan.template.form</field>
        <field name="model">account.loan.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="company_id" invisible="1" />
                            <field
                                name="company_id"
                                options="{'no_create': True}"
                                groups="base.group_multi_company"
                            />
                            <field name="loan_type" />
                            <field name="loan_amount" />
                            <field name="rate_type" />
                            <field name="rate" />
                            <field name="is_leasing" />
                            <field name="start_date" />
                            <field name="periods" />
                            <field name="method_period" />
                            <field name="post_invoice" />
                        </group>

                        <group>
                            <field name="journal_type" invisible="1"/>
                            <field name="journal_id" />
                            <field name="short_term_loan_account_id" />
                            <field name="long_term_loan_account_id" />
                            <field name="interest_expenses_account_id" />
                            <field name="leased_asset_account_id" />
                            <field name="product_id" />
                            <field name="interests_product_id" />

                            <field name="round_on_end" />
                            <field name="payment_on_first_period" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_loan_template_action" model="ir.actions.act_window">
        <field name="name">Loan Template</field>
        <field name="res_model">account.loan.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="loan_template_menu"
        name="Loan Template"
        parent="account_loan.loan_menu"
        sequence="75"
        action="account_loan_template_action"
    />

</odoo>
