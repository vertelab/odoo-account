<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: commodity kanban -->
    <record id="action_product_commodity" model="ir.actions.act_window">
        <field name="name">Commodities</field>
        <field name="res_model">product.commodity</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_precious_metals': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your first commodity
            </p>
            <p>
                Commodities track market prices for raw materials like gold,
                silver, copper, and oil. Prices are fetched automatically
                from your configured API provider.
            </p>
        </field>
    </record>

    <!-- Action: commodity qualities -->
    <record id="action_product_commodity_quality" model="ir.actions.act_window">
        <field name="name">Qualities</field>
        <field name="res_model">product.commodity.quality</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- Action: revaluation wizard -->
    <record id="action_commodity_revaluation_wizard" model="ir.actions.act_window">
        <field name="name">Revalue Commodity</field>
        <field name="res_model">commodity.revaluation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_product_commodity"/>
        <field name="binding_view_types">kanban,form</field>
        <field name="context">{'default_commodity_id': active_id}</field>
    </record>

    <!-- Menu: top-level under Accounting/Configuration -->
    <menuitem id="menu_commodity_root" name="Commodities"
              sequence="90"               parent="account.menu_finance_configuration"
              action="action_product_commodity"
              groups="account.group_account_user"/>
</odoo>
