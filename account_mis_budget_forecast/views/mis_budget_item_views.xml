<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Item List View Extension -->
    <record id="mis_budget_by_account_item_list_hierarchy" model="ir.ui.view">
        <field name="name">mis.budget.by.account.item.list.hierarchy</field>
        <field name="model">mis.budget.by.account.item</field>
        <field name="inherit_id" ref="mis_builder_budget.mis_budget_by_account_item_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field name="forecast_amount"
                       optional="show"
                       string="Forecast"
                       decoration-info="budget_id.is_forecast == True"/>
                <field name="hierarchical_balance"
                       optional="hide"
                       string="Hier. Bal."
                       decoration-bf="is_node == True"/>
                <field name="hierarchical_forecast"
                       optional="hide"
                       string="Hier. Forecast"/>
            </xpath>
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="is_node" optional="hide"/>
                <field name="parent_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
