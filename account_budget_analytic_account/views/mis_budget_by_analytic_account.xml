<odoo>
    <record model="ir.ui.view" id="mis_budget_by_analytic_account_form_view">
        <field name="name">mis.budget.by.analytic.account.form (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.analytic.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_draft" string="Set draft" type="object" invisible="state == 'draft'"/>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(account_budget_analytic_account.mis_budget_by_analytic_account_item_act_window)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-bars"
                            string="Budget items"
                        />
                    </div>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="company_id" groups="base.group_multi_company" />
                    </group>
                    <group>
                        <field name="date_range_id" />
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="allow_items_overlap" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="mis_budget_by_analytic_account_search_view">
        <field name="name">mis.budget.by.analytic.account.search (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.analytic.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="mis_budget_by_analytic_account_tree_view">
        <field name="name">mis.budget.by.analytic.account.tree (in mis_builder_budget)</field>
        <field name="model">mis.budget.by.analytic.account</field>
        <field name="arch" type="xml">
	    <list>
                <field name="name" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="mis_budget_by_analytic_account_act_window">
        <field name="name">MIS Budgets (by analytic accounts)</field>
        <field name="res_model">mis.budget.by.analytic.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="mis_budget_by_analytic_account_menu">
        <field name="name">MIS Budgets (by analytic accounts)</field>
        <field name="parent_id" ref="mis_builder.mis_report_finance_menu" />
        <field name="action" ref="mis_budget_by_analytic_account_act_window" />
        <field name="sequence" eval="210" />
    </record>

    <record id="model_account_analytic_aggregate_action" model="ir.actions.server">
        <field name="name">Aggregate Analytic Budget</field>
        <field name="model_id" ref="account_budget_analytic_account.model_mis_budget_by_analytic_account"/>
        <field name="binding_model_id" ref="account_budget_analytic_account.model_mis_budget_by_analytic_account"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_aggregate_account_analytic()</field>
    </record>



</odoo>
