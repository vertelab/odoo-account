<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rule on project.tags.
             20.0 merged ir.rule into ir.access.domain: the same domain is a
             restriction on the access record instead of a separate rule. -->
        <record model="ir.access" id="project_tags_comp_rule">
            <field name="name">Project Tags: multi-company</field>
            <field name="model_id" ref="project.model_project_tags"/>
            <field name="operation">crud</field>
            <field name="domain">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
