<odoo>
    <data>

        <record id="account_asset_management_account_asset_view_form_inherit" model="ir.ui.view">
            <field name="name">account_asset_management_account_asset_view_form_inherit</field>
            <field name="model">account.asset</field>
            <field name="inherit_id" ref="account_asset_management.account_asset_view_form"/>
            <field name="arch" type="xml">
                   <button class="oe_stat_button" icon="fa-bars" name="open_entries" type="object" position="after">
                      <field name="personal_equipment_id" invisible="True"/>
                      <button name="action_view_equipment" string="Equipment" type="object" class="oe_stat_button" icon="fa-cubes" invisible="personal_equipment_id == False" />
                  </button>
            </field>
        </record>
        
        
        
    </data>
</odoo>
